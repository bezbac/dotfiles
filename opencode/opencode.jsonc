{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,

  "lsp": true,

  "default_agent": "plan",

  "experimental": {
    "openTelemetry": true,
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 15000,
    "reserved": 0,
  },

  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 128000,
            "output": 128000,
          },
        },
      },
    },
  },

  "plugin": ["@mohak34/opencode-notifier@0.1.15", "./plugins/zellij-tabula.ts"],

  "permission": {
    "external_directory": {
      "~/dev/repos/bezbac/knowledge**": "allow",
    },

    "edit": "allow",

    "read": {
      // Deny reading .env files
      ".env": "deny",
      ".env.*": "deny",
      ".env-*": "deny",
      "*.env.example": "allow",

      // Deny reading terraform var and state files
      ".tfvars": "deny",
      ".tfvars*": "deny",
      ".tfstate": "deny",
      ".tfstate*": "deny",
    },

    "bash": {
      "*": "ask",

      // Basic unix commands
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "which *": "allow",
      "wc *": "allow",
      "printf *": "allow",
      "timeout *": "allow",

      // Common cli tools
      "pnpm *": "allow",
      "npm *": "allow",
      "yarn *": "allow",
      "uv *": "allow",
      "moon *": "allow",
      "vitest *": "allow",
      "pnpx *": "allow",

      // Rust commands
      "cargo *": "allow",
      "cargo install *": "ask",

      // Terraform commands
      "terraform *": "deny",
      "terraform init": "allow",
      "terraform validate": "allow",

      // Git commands
      "git log *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git symbolic-ref *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "git grep *": "allow",
      "git commit": "deny",
      "git push *": "deny",

      // GitHub CLI commands
      "gh pr view *": "allow",
      "gh pr diff *": "allow",

      // Crit
      "crit *": "allow",

      // Dangerous commands
      "op *": "deny", // 1password CLI
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny", // fork bomb, just in case,
    },
  },

  "mcp": {
    // Docs lookup for libraries - https://context7.com
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },

    // Web fetching - MCP official server (Python via uvx)
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
    },

    // Code search - Grepika
    "grepika": {
      "type": "local",
      "command": ["grepika", "--mcp"],
    },

    // Code reading - Tilth
    "tilth": {
      "type": "local",
      "command": ["/Users/ben.bachem/.cargo/bin/tilth", "--mcp"],
    },

    // GitHub code search - Grep.app
    "grep.app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },
}
