{
  "$schema": "https://opencode.ai/config.json",

  "update": "auto",

  "lsp": true,

  "shell": "/Users/ben.bachem/dev/repos/bezbac/dotfiles/sandbox/zsh",

  "default_agent": "plan",

  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": 0,
  },

  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 128000,
            "output": 128000,
          },
        },
      },
    },
  },

  "plugins": [
    "./plugins/zellij-tabula.ts",
    "./plugins/post-edit-hooks.ts",
  ],

  "permissions": [
    { "action": "external_directory", "resource": "~/dev/repos/bezbac/knowledge**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.gitconfig", "effect": "allow" },
    { "action": "external_directory", "resource": "~/dev/repos/**/.git/**/*", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },

    // Deny reading .env files
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": ".env-*", "effect": "deny" },
    { "action": "read", "resource": "*.env*.example", "effect": "allow" },

    // Deny reading terraform var and state files
    { "action": "read", "resource": ".tfvars", "effect": "deny" },
    { "action": "read", "resource": ".tfvars*", "effect": "deny" },
    { "action": "read", "resource": ".tfstate", "effect": "deny" },
    { "action": "read", "resource": ".tfstate*", "effect": "deny" },

    { "action": "read", "resource": "~/.gitconfig", "effect": "allow" },
    { "action": "read", "resource": "~/dev/repos/**/.git/**/*", "effect": "allow" },

    // "*": "ask",

    // Basic unix commands
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "timeout *", "effect": "allow" },

    // Common cli tools
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },
    { "action": "shell", "resource": "uv *", "effect": "allow" },
    { "action": "shell", "resource": "moon *", "effect": "allow" },
    { "action": "shell", "resource": "vitest *", "effect": "allow" },
    { "action": "shell", "resource": "pnpx *", "effect": "allow" },

    // Rust commands
    { "action": "shell", "resource": "cargo *", "effect": "allow" },
    { "action": "shell", "resource": "cargo install *", "effect": "ask" },

    // Terraform commands
    { "action": "shell", "resource": "terraform *", "effect": "deny" },
    { "action": "shell", "resource": "terraform init", "effect": "allow" },
    { "action": "shell", "resource": "terraform validate", "effect": "allow" },

    // Git commands. Everything except push is auto-approved: it only mutates the
    // local repo (contained by the sandbox) or does read-only network fetch/pull.
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git symbolic-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git commit", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git rm *", "effect": "allow" },
    { "action": "shell", "resource": "git mv *", "effect": "allow" },
    { "action": "shell", "resource": "git restore *", "effect": "allow" },
    { "action": "shell", "resource": "git reset *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git stash *", "effect": "allow" },
    { "action": "shell", "resource": "git tag *", "effect": "allow" },
    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    { "action": "shell", "resource": "git rebase *", "effect": "allow" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "allow" },
    { "action": "shell", "resource": "git revert *", "effect": "allow" },
    { "action": "shell", "resource": "git clean *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    { "action": "shell", "resource": "git submodule *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree *", "effect": "allow" },

    // GitHub CLI commands
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },

    // Crit
    { "action": "shell", "resource": "crit *", "effect": "allow" },

    // Dangerous commands
    { "action": "shell", "resource": "op *", "effect": "deny" }, // 1password CLI
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": ":(){:|:&};:", "effect": "deny" }, // fork bomb, just in case,

    // Permission matching uses the last matching rule. Keep publishing actions last.
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
  ],

  "mcp": {
    "servers": {
      // Docs lookup for libraries - https://context7.com
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },

      // Web fetching - MCP official server (Python via uvx)
      "fetch": {
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"],
      },

      // Code search - Grepika
      "grepika": {
        "type": "local",
        "command": ["grepika", "--mcp"],
      },

      // Code reading - Tilth
      "tilth": {
        "type": "local",
        "command": ["/Users/ben.bachem/.cargo/bin/tilth", "--mcp"],
      },

      // GitHub code search - Grep.app
      "grep.app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
    },
  },
}
